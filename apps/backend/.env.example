# Copy to .env and fill in. Never commit .env.
TINYFISH_API_KEY=
PORT=8787

# true = return a canned audit (works offline, great for demo backup).
# It is also used automatically when TINYFISH_API_KEY is empty.
MOCK_TINYFISH=false

# Optional: comma-separated hosts Deep Check is allowed to visit. Empty = any public host.
ALLOWED_HOSTS=

# Optional override (defaults to the TinyFish sync run endpoint)
# TINYFISH_ENDPOINT=https://agent.tinyfish.ai/v1/automation/run
